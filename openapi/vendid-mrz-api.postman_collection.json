                  "value": "application/json"
                }
              ],
              "body": "{\n  \"format\": \"TD3\",\n  \"document_type\": \"<string>\",\n  \"issuing_state\": \"<string>\",\n  \"surname\": \"<string>\",\n  \"given_names\": \"<string>\",\n  \"document_number\": \"<string>\",\n  \"nationality\": \"<string>\",\n  \"birth_date\": \"<string,null-date>\",\n  \"sex\": \"<string>\",\n  \"expiry_date\": \"<string,null-date>\",\n  \"optional_data\": \"<string>\",\n  \"check_digits\": {\n    \"document_number\": \"<boolean>\",\n    \"birth_date\": \"<boolean>\",\n    \"expiry_date\": \"<boolean>\",\n    \"composite\": \"<boolean>\"\n  },\n  \"mrz\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"ms\": \"<integer>\",\n  \"specimen\": {\n    \"const\": true,\n    \"description\": \"Present only when the ICAO specimen passport (L898902C3) was read; such reads are free\"\n  }\n}",
