{
  "item": [
    {
      "name": "MRZ",
      "description": "Read the machine-readable zone of passports and ID cards",
      "item": [
        {
          "id": "7fda555b-36a6-4d8a-a1f1-e547e491ef2e",
          "name": "Read the MRZ of a passport or ID card image",
          "request": {
            "name": "Read the MRZ of a passport or ID card image",
            "description": {
              "content": "Body: `multipart/form-data` with the image in the field `image` (also accepted: `file`, `frame`), or the raw\nimage bytes with `Content-Type: image/jpeg`, `image/png` or `image/webp`. Max 10 MB. A photo of the data page\nor a whole camera frame both work: the document is found in the image. CORS is open.\n\nThe ICAO specimen passport (document number L898902C3, https://vend-id.com/sdk/specimen.jpg) is free and\nanswers with `\"specimen\": true`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "mrz"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "description": {
                    "content": "(Required) Photo or camera frame showing the document's MRZ",
                    "type": "text/plain"
                  },
                  "key": "image",
                  "type": "file",
                  "contentType": "image/jpeg, image/png, image/webp"
                }
              ]
            },
            "auth": null
          },
          "response": [
            {
              "id": "c9cf30a7-854e-49eb-9c0c-d03381250e27",
              "name": "MRZ read; all check digits valid",
